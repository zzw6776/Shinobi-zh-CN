                </main>
                <main class="container page-tab pt-3" id="tab-customAutoLoad">
                    <div id="customAutoLoad"><%- include('blocks/superCustomAutoLoadManager'); %></div>
                </main>
                <main class="container page-tab pt-3" id="tab-changeSuperPreferences">
                    <div id="changeSuperPreferences"><%- include('blocks/superPreferences'); %></div>
                </main>
                <main class="container page-tab pt-3" id="tab-easyRemoteAccess">
                    <div id="easyRemoteAccess"><%- include('blocks/easyRemoteAccess'); %></div>
                </main>
                <main class="container page-tab pt-3" id="tab-superPluginManager">
                    <div id="superPluginManager"><%- include('blocks/superPluginManager'); %></div>
                </main>
                <main class="container page-tab pt-3" id="tab-superMountManager">
                    <div id="superMountManager"><%- include('blocks/superMountManager'); %></div>
                </main>
                <main class="container page-tab pt-3" id="tab-cloudUploaders">
                    <div id="cloudUploaders"><%- include('blocks/superCloudUploaders'); %></div>
                </main>
                <%- include('blocks/superCentralManagement'); %>
                <% if(!config.isFailover){ %>
                    <%- include('blocks/superFailoverServers'); %>
                <% }else{ %>
                    <%- include('blocks/superFailoverKeys'); %>
                <% } %>
                <% customAutoLoad.superPageBlocks.forEach(function(block){ %>
                    <%- include(block) %>
                <% }) %>
            </main>
        </div>
