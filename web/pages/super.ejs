    <div class="container-fluid">
        <div class="row">
            <%- include('blocks/super/menuSide'); %>
            <main id="pageTabContainer" class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <%
                // Each tab is the engine's `#tab-<name>` wrapper around a div that keeps the
                // id the old shell gave the panel. Every super module scopes itself to that
                // id -- `$('#system')`, `$('#config')`, `$('#superMountManager')` and so on --
                // and binds its handlers with `theEnclosure.find(...)`, so the inner id has to
                // survive or the whole tab goes dead.
                %>
                <main class="container page-tab pt-3" id="tab-accounts">
                    <div id="accounts">
                        <div class="row">
                            <div class="col-md-5 text-left">
                                <%- include('blocks/heyActivate'); %>
                                <%- include('blocks/systemInfoBlock'); %>
                            </div>
                            <div class="col-md-7">
                                <div class="mb-4"><a href="#" class="add btn btn-block btn-default"><i class="fa fa-plus"></i> <%- lang.Add %></a></div>
                                <div class="form-group-group red p-1" style="max-height:400px;overflow:auto">
                                    <div id="accounts-list"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
                <main class="container page-tab pt-3" id="tab-config">
                    <div id="config"><%- include('blocks/superConfigEditor'); %></div>
                </main>
                <main class="container page-tab pt-3" id="tab-system">
