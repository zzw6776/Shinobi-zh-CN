<main class="container page-tab pt-3 text-left" id="tab-failoverKeys">
<%# inner id kept: super.failoverServers.isFailover.js scopes itself to $('#failoverKeys') %>
<div id="failoverKeys">
    <form>
        <div class="row" style="display:flex">
            <div class="col-md-12">
                <% if(!config.userHasSubscribed){ %>
                    <div class="card bg-dark text-white mb-4">
                        <div class="card-header">
                            <%- lang['Failover Keys'] %>
                        </div>
                        <div class="card-body">
                            <div class="text-center"><%- lang.failoverServersNotEnabled %></div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="card bg-dark text-white mb-4">
                        <div class="card-header">
                            <%- lang['Failover Keys'] %>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3"><%- lang.failoverKeysDescription %></div>
                            <div class="form-group">
                                <input placeholder="<%- lang['Server Key'] %>" class="form-control btn btn-dark text-left text-white" type="text" name="failoverServer" value="" placeholder="ws://127.0.0.1:8663">
                            </div>
                        </div>
                    </div>
                    <div class="card bg-dark text-white">
                        <div class="card-body">
                            <table class="table table-striped">
                                <tbody id="failoverKeys-list"></tbody>
                            </table>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    <%- include('super/stickySubmitBar'); %>
    </form>
    <script src="<%-window.libURL%>assets/js/super.failoverServers.isFailover.js" type="text/javascript"></script>
</div>
</main>
