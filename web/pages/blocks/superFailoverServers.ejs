<main class="container page-tab pt-3 text-left" id="tab-failoverServers">
<%# inner id kept: super.failoverServers.isNormal.js scopes itself to $('#failoverServers') %>
<div id="failoverServers">
    <form>
        <div class="row" style="display:flex">
            <div class="col-md-12">
                <%# Shown whether or not the feature is usable - what failover is for is the
                    first thing missing when you land on this tab. %>
                <div class="alert alert-info">
                    <b><i class="fa fa-info-circle"></i> <%- lang['Failover Servers'] %></b>
                    <div class="mt-1"><small><%- lang.failoverHowTo %></small></div>
                    <div class="mt-1"><small><a href="https://hub.shinobi.video/articles/view/Wg3wTA7fqbyP4yA" target="_blank" rel="noopener"><%- lang.failoverDocsLink %> <i class="fa fa-external-link"></i></a></small></div>
                </div>
                <% if(!config.userHasSubscribed){ %>
                    <div class="card bg-dark text-white mb-4">
                        <div class="card-header">
                            <%- lang['Failover Servers'] %>
                        </div>
                        <div class="card-body">
                            <div class="text-center"><%- lang.failoverServersNotEnabled %></div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="card bg-dark text-white mb-4">
                        <div class="card-header">
                            <%- lang['Failover Servers'] %>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3"><%- lang.failoverServersDescription %></div>
                            <div class="form-group">
                                <input placeholder="<%-lang['Server URL']%>" class="form-control btn btn-dark text-left text-white" type="text" name="failoverServer" value="" placeholder="ws://127.0.0.1:8663">
                            </div>
                            <div class="form-group">
                                <input placeholder="<%-lang['Server Key']%>" class="form-control btn btn-dark text-left text-white" type="text" name="peerConnectKey" value="" placeholder="API Key from https://licenses.shinobi.video">
                            </div>
                            <%# Its own button rather than only the floating save bar, which
                                is shared page furniture and does not read as "add this
                                server to the list below". Same as the Central Management tab. %>
                            <div>
                                <a class="btn btn-success btn-block" id="failoverServersAdd"><i class="fa fa-plus"></i> <%- lang['Add Failover Server'] %></a>
                            </div>
                        </div>
                    </div>
                    <div class="card bg-dark text-white">
                        <div class="card-body">
                            <table class="table table-striped">
                                <tbody id="failoverServers-list"></tbody>
                            </table>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    <%- include('super/stickySubmitBar'); %>
    </form>
    <script src="<%-window.libURL%>assets/js/super.failoverServers.isNormal.js" type="text/javascript"></script>
</div>
</main>
