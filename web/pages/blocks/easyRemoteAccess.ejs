<%
    const p2pServerList = config.p2pServerList || {}
    const selectedServers = config.p2pHostMultiSelected
    const multipleSelected = selectedServers instanceof Array && selectedServers.length > 0;
 %>
 <style>
     /* Scoped to this block. These were bare `blockquote` / `.epic-text-filter` rules, which
        was harmless while the block only ever rendered on the Superuser panel -- but it now
        also renders in the dashboard, where drawBlock emits a <blockquote> for any definition
        block that declares one, so the unscoped rule restyled boxes all over the dashboard. */
     #easyRemoteAccess .epic-text-filter {
         text-transform: none;
        letter-spacing: 0.5pt;
        font-size: 9pt;
     }
     #easyRemoteAccess blockquote {
         background: #073c3e;
        height: 100%;
        border-radius: 15px;
        color: #fff;
        padding: 10px;
        font-style: italic;
        box-shadow: 0 0 5px #19ce11;
     }
 </style>
 <script>
     window.p2pServerList = <%- JSON.stringify(p2pServerList) %>
     window.multipleSelected = <%- multipleSelected %>
     window.selectedServers = <%- JSON.stringify(selectedServers) %>
     window.p2pHostSelected = <%- JSON.stringify(config.p2pHostSelected || '') %>
     window.useBetterP2P = <%- !!config.useBetterP2P %>
 </script>
<link rel="stylesheet" href="<%-window.libURL%>assets/css/super.easyRemoteAccess.css">
<form>
    <div class="row" style="display:flex">
        <div class="col-md-6">
            <div class="card bg-dark text-white mb-4">
                <div class="card-header">
                    <%- lang['Easy Remote Access (P2P)'] %>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <select class="form-control py-0 btn btn-dark text-left text-white" type="email" name="p2pEnabled">
                            <option <% if(config.p2pEnabled === true){ %>selected<% } %> value="1"><%- lang.On %></option>
                            <option <% if(config.p2pEnabled !== true){ %>selected<% } %> value="0"><%- lang.Off %></option>
                        </select>
                    </div>
                    <div class="form-group p2p-toggle-affected">
                        <input placeholder="<%-lang['P2P API Key']%>" class="form-control btn btn-dark text-left text-white" type="text" name="p2pApiKey" value="<%- config.p2pApiKey %>">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-dark text-white  mb-4">
                <div class="card-header">
                    <%- lang['How to Connect'] %>
                </div>
                <div class="card-body">
                    <p><%- lang['HowToConnectDes1'] %></p>
                    <p><%- lang['HowToConnectDes2'] %></p>
                    <p class="mb-0"><a class="btn btn-sm btn-info" href="https://hub.shinobi.video/articles/view/3Yhivc6djTtuBPE" target="_blank"><%- lang['How to Connect'] %></a></p>
                </div>
            </div>
        </div>
    </div>
    <%# Rows are drawn by super.easyRemoteAccess.js once every server has been probed, so
        that the list only ever shows servers that actually answered. %>
    <div class="row p2p-toggle-affected" id="p2pServerList">
        <div class="col-md-12">
            <div class="card bg-dark text-white mb-4">
                <div class="card-body">
                    <div id="p2pServerListLoading" class="text-center py-4">
                        <i class="fa fa-spinner fa-pulse fa-2x"></i>
                        <div class="mt-2"><small><%- lang.p2pCheckingServers %></small></div>
                    </div>
                    <div id="p2pServerListEmpty" class="text-center py-4" style="display:none">
                        <small><%- lang.p2pNoServersOnline %></small>
                    </div>
                    <table class="table table-striped mb-0" id="p2pServerTable" style="display:none">
                        <thead>
                            <tr>
                                <th><%- lang.Name %></th>
                                <th><%- lang['Host Address'] %></th>
                                <th><%- lang['Download Bandwidth'] %></th>
                                <th><%- lang['Upload Bandwidth'] %></th>
                                <th class="text-right"><%- lang.Actions %></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <%- include('super/stickySubmitBar'); %>
</form>
<script>
// Shared by the Superuser panel and the dashboard's Easy Remote Access tab. The dashboard
// sets this itself (it needs getApiPrefix, which only exists once the footer scripts have
// run), so only fall back to the Superuser session form when nothing set it.
$(document).ready(function(){
    if(window.remoteAccessApiPrefix)return;
    window.remoteAccessApiPrefix = `${superApiPrefix}${$user.sessionKey}/p2p`
})
</script>
<script src="<%-window.libURL%>assets/js/super.easyRemoteAccess.js" type="text/javascript"></script>
